#!/bin/sh
#
# task-run — AgentOS task execution and logging script
#
# Usage:
#   task-run <command> [args...]
#
# Behavior:
#   1. Generate unique task_id (format: YYYYMMDDTHHMMSSZ-NNNN)
#   2. Create .log file under tasks/YYYYMMDD/
#   3. Append a running status record to tasks/index.jsonl
#   4. Execute command, redirect stdout/stderr to .log file
#   5. Update status to done/failed in index.jsonl (append-only strategy, append new line keeps original running line)
#
# Dependencies (pure POSIX): date, mkdir, sh, awk, sed, cat, mv, printf
# Not dependent on: jq, python, flock (BusyBox ash doesn't have built-in flock support)
#

set -eu

LOG_ROOT="/var/log/sandbox/tasks"
INDEX="$LOG_ROOT/index.jsonl"

# ------------------------------------------------------------
# 0. Argument validation
# ------------------------------------------------------------
if [ $# -eq 0 ]; then
    echo "Usage: task-run <command> [args...]" >&2
    exit 1
fi

# Convert command to printable string (for JSON field)
# Use printf %q to escape each argument, spaces become \x20 etc.
_cmd_str=""
for _arg in "$@"; do
    _quoted=$(printf '%s' "$_arg" | sed 's/\\/\\\\/g; s/"/\\"/g')
    _cmd_str="$_cmd_str\"$_quoted\","
done
# Remove trailing comma, assemble JSON array fragment
_command_json="[${_cmd_str%,}]"

# ------------------------------------------------------------
# 1. Generate task_id (atomic incrementing sequence)
# ------------------------------------------------------------
_date=$(date -u '+%Y%m%d')
_ts=$(date -u '+%Y%m%dT%H%M%SZ')
_seq_file="$LOG_ROOT/.seq.${_date}"

# Atomic sequence increment: write temp file first, then mv (same filesystem atomic operation)
# Even if two task-run instances run concurrently, sequence won't be lost
# -f force overwrite, no interactive confirmation (BusyBox ash waits for stdin when target exists)
_seq=$(cat "$_seq_file" 2>/dev/null || echo 0)
_seq=$((_seq + 1))
printf '%s' "$_seq" > "$LOG_ROOT/.seq.${_date}.tmp"
mv -f "$LOG_ROOT/.seq.${_date}.tmp" "$_seq_file"

_task_id="${_ts}-$(printf '%04d' "$_seq")"

# ------------------------------------------------------------
# 2. Create today's directory
# ------------------------------------------------------------
_log_dir="$LOG_ROOT/$_date"
mkdir -p "$_log_dir"

_log_path="$_log_dir/${_task_id}.log"
_log_path_relative="tasks/$_date/${_task_id}.log"

# ------------------------------------------------------------
# 3. Write index.jsonl (running status)
# ------------------------------------------------------------
_start_ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
_user=$(id -nu)
_cwd=$(pwd)

# Construct JSON line (pure shell, no jq)
# Field order fixed, easy to slice by position with awk -F'"'
_index_line=$(printf '{"task_id":"%s","ts":"%s","user":"%s","cwd":"%s","command":%s,"log_path":"%s","status":"running","exit_code":null}' \
    "$_task_id" "$_start_ts" "$_user" "$_cwd" "$_command_json" "$_log_path_relative")

printf '%s\n' "$_index_line" >> "$INDEX"

# ------------------------------------------------------------
# 4. Execute command and record stdout/stderr
# ------------------------------------------------------------
# Log file header: task metadata comments (human readable)
{
    printf '# task_id: %s\n' "$_task_id"
    printf '# ts: %s\n' "$_start_ts"
    printf '# cwd: %s\n' "$_cwd"
    printf '# command: '
    printf '%s ' "$@"
    printf '\n'
    printf '+ '
    printf '%s ' "$@"
    printf '\n'
} > "$_log_path"

# Execute command: append to log file, also pass through to terminal (tee -a)
# BusyBox ash doesn't support PIPESTATUS, use set +e + $? to capture exit code
set +e
"$@" 2>&1 | tee -a "$_log_path"; _exit=$?
set -e

# ------------------------------------------------------------
# 5. Update index.jsonl (append new line, keep original running line)
#
# Note: index.jsonl has chattr +a (append-only attribute) set,
#       sed -i in-place overwrite will fail (EPERM), use append-new-line strategy:
#         - Original "running" line kept (cannot delete or overwrite)
#         - Append updated line at end (status=done/failed + exit_code)
#         - Final file has two lines per task: first running, second final status
#         - When parsing, take last entry for each task_id
# ------------------------------------------------------------
_end_ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

if [ $_exit -eq 0 ]; then
    _status="done"
else
    if [ $_exit -ge 128 ]; then
        _status="signal"
    else
        _status="failed"
    fi
fi

_new_line=$(printf '{"task_id":"%s","ts":"%s","user":"%s","cwd":"%s","command":%s,"log_path":"%s","status":"%s","exit_code":%s}' \
    "$_task_id" "$_start_ts" "$_user" "$_cwd" "$_command_json" "$_log_path_relative" "$_status" "$_exit")

printf '%s\n' "$_new_line" >> "$INDEX"

# ------------------------------------------------------------
# 6. Complete
# ------------------------------------------------------------
