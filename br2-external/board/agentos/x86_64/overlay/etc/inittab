# ============================================================
# BusyBox init execution order (manual.md §6.3, BusyBox inittab syntax reference):
#   1. sysinit actions execute in sequence, init waits for each to complete
#   2. wait actions execute in sequence, init waits for each to complete
#   3. once actions execute, no waiting
#   4. askfirst / respawn actions execute
#
# Note: Custom overlay overrides BusyBox default inittab (/etc/inittab),
#       therefore must manually complete mount / remount / rcS and other necessary initialization steps.
# ============================================================

# Remount root filesystem as read-write (override BusyBox default remount,
# ext2 image mounts read-only by default, this step needed to write logs and create directories)
::sysinit:/bin/mount -o remount,rw /

# Mount 9P virtfs (host shared directory)
# If mount fails, continue startup (subsequent operations will detect missing directories)
::sysinit:/bin/mkdir -p /mnt/agent_bridge && /bin/mount -t 9p -o trans=virtio,cache=loose agent_bridge /mnt/agent_bridge || echo "[init] agent_bridge mount failed, continuing..."
::sysinit:/bin/mkdir -p /workspace && /bin/mount -t 9p -o trans=virtio,cache=loose workspace /workspace || echo "[init] workspace mount failed, continuing..."

# Mount devpts and /dev/shm (needed by Python/multi-threaded programs for shared memory)
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mkdir -p /dev/shm && /bin/mount -t tmpfs tmpfs /dev/shm -o size=64M

# Mount procfs (many tools depend on /proc/mounts)
::sysinit:/bin/mount -t proc proc /proc

# Execute system skeleton rcS (BR2_ROOTFS_OVERLAY doesn't include system/skeleton/rcS)
::sysinit:/etc/init.d/rcS

# Project-level startup script: create runtime directories, initialize logs, etc.
::sysinit:/etc/init.d/rcS.local

# Start network (auto DHCP or static IP)
::sysinit:/etc/init.d/S40network start

# [Debug mode disabled] agent main loop temporarily commented out, run manually
# ::sysinit:/bin/nohup /bin/sh /home/agent/agent_main_loop.sh > /dev/null 2>&1 &

# Agent interactive shell (serial ttyS0, for manual debugging)
ttyS0::respawn:/bin/sh /etc/autologin-agent.sh

