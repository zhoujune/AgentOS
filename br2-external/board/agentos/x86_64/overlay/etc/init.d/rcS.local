#!/bin/sh
#
# rcS.local — AgentOS project-level system initialization
#
# Called by inittab ::sysinit, executed after BusyBox rcS
# Responsible for agent user's runtime directory initialization and log system readiness
#

# ============================================================
# 0. Ensure root filesystem is writable (fallback remount)
#
# Note: Buildroot BusyBox rcS executes before overlay, which may cause
# remount in custom inittab to fail. rcS.local makes final remount attempt.
# ============================================================
mount -o remount,rw / 2>/dev/null || true

# ============================================================
# 1. Ensure log directories exist and are writable
# ============================================================
# post_build.sh / post_fakeroot.sh create these directories during image build,
# here we do runtime secondary check (prevent overlay missing or image mount issues)
mkdir -p /var/log/sandbox/tasks
mkdir -p /var/log/sandbox/vtrm
mkdir -p /var/lib/agentos/approvals/pending
mkdir -p /var/lib/agentos/approvals/approved
mkdir -p /var/lib/agentos/approvals/used
mkdir -p /var/lib/agentos/approvals/tokens
mkdir -p /var/lib/agentos

# ============================================================
# 2. Initialize index.jsonl and sequence files (as root)
# ============================================================
# rcS.local runs as root, here complete all privileged initialization
# post_image.sh attempts to set chattr during build, rcS.local provides runtime fallback
if [ ! -f /var/log/sandbox/tasks/index.jsonl ]; then
    touch /var/log/sandbox/tasks/index.jsonl
fi
chown 1000:1000 /var/log/sandbox/tasks/index.jsonl
chmod 644 /var/log/sandbox/tasks/index.jsonl

DATE=$(date -u '+%Y%m%d')
SEQ_FILE="/var/log/sandbox/tasks/.seq.${DATE}"

if [ ! -f "$SEQ_FILE" ]; then
    rm -f /var/log/sandbox/tasks/.seq.placeholder
    touch "$SEQ_FILE"
    chown 1000:1000 "$SEQ_FILE"
    chmod 600 "$SEQ_FILE"
fi

# ============================================================
# 3. Set append-only attribute (chattr +a)
#
# This is the final defense against "smart agents":
#   - index.jsonl: append-only, agent cannot truncate (cannot clear logs)
#   - .seq. files: append-only, agent cannot modify counter (prevent sequence rollback)
#
# chattr/e2fsprogs is included via BR2_PACKAGE_E2FSPROGS=y in defconfig
# If chattr doesn't exist (e.g., ext4/vfat non-ext filesystems), silently skip
# ============================================================
_set_append_only() {
    local _f="$1"
    [ -f "$_f" ] || return 0
    command -v chattr >/dev/null 2>&1 || return 0
    chattr +a "$_f" 2>/dev/null || true
}

_set_append_only /var/log/sandbox/tasks/index.jsonl
# Note: .seq. files do not set chattr +a, because task-run needs mv to rename tmp files.
# chattr +a forbids all write operations (including mv), sequence increment would fail.
# Sequence file protection relies on: chmod 600 (owner-only write) + directory sticky-bit.

# ============================================================
# 4. Set directory sticky-bit
#
# Defense strategy (with chattr +a):
#   - Directory ownership = agent:agent, agent has write permission to mkdir and create files
#   - sticky-bit (o+t) = files in directory can only be deleted by owner (protect other Agents' files)
#   - Note: chattr +a locks at file level for append, directory level deletion protection from sticky-bit
#   - index.jsonl protected by root:root 644 + chattr +a
#
#   Permission structure:
#     /var/log/sandbox/tasks/     agent:agent 1775 (sticky-bit ON)
#     index.jsonl                 root:root   644  + chattr +a
#     .seq.YYYYMMDD               agent:agent 600  + chattr +a
#     *.log                       agent:agent 644
# ============================================================
chown 1000:1000 /var/log/sandbox/tasks/
chmod 1775 /var/log/sandbox/tasks/   # rwx rwx rwt — 7+1=owner+group+other(含t)

# ============================================================
# 5. Set agent working directories
# ============================================================
chown 1000:1000 /var/log/sandbox/vtrm 2>/dev/null || true
chmod 755 /var/log/sandbox/vtrm 2>/dev/null || true
chown 1000:1000 /var/lib/agentos 2>/dev/null || true
chmod 755 /var/lib/agentos 2>/dev/null || true
chown -R 1000:1000 /var/lib/agentos/approvals 2>/dev/null || true
chmod 755 /var/lib/agentos/approvals 2>/dev/null || true
chmod 755 /var/lib/agentos/approvals/pending 2>/dev/null || true
chmod 755 /var/lib/agentos/approvals/approved 2>/dev/null || true
chmod 755 /var/lib/agentos/approvals/used 2>/dev/null || true
chmod 755 /var/lib/agentos/approvals/tokens 2>/dev/null || true
if [ -e /var/lib/agentos/agent.db ]; then
    chown 1000:1000 /var/lib/agentos/agent.db 2>/dev/null || true
    chmod 600 /var/lib/agentos/agent.db 2>/dev/null || true
fi

mkdir -p /home/agent
