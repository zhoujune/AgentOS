#!/bin/sh
#
# S40network — AgentOS 网络初始化脚本
#
# 功能：
#   1. 等待网络设备就绪
#   2. 配置 virtio-net 网卡
#   3. 启动 DHCP 客户端获取 IP
#   4. 配置 DNS 和默认路由
#
# 由 inittab 的 ::sysinit 调用，在 rcS.local 之前执行
#

set -e

TRACE_DIR="${TRACE_DIR:-/var/log/sandbox/trace}"
TRACE_JSONL="$TRACE_DIR/trace.jsonl"

log_jsonl() {
    local event="$1"
    shift
    local ts
    ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    mkdir -p "$TRACE_DIR" 2>/dev/null || true
    printf '%s\n' "{\"event\":\"$event\",\"ts\":\"$ts\",\"$*\"}" >> "$TRACE_JSONL" 2>/dev/null || true
}

# 检测网卡名称
detect_netdev() {
    # virtio-net 通常命名为 eth0，但在某些情况下可能是其他名称
    # 检查常见的网卡名
    for dev in eth0 ens3 enp0s3; do
        if [ -d "/sys/class/net/$dev" ]; then
            echo "$dev"
            return 0
        fi
    done

    # 动态检测：找第一个 UP 或已存在的网卡
    for dev in /sys/class/net/*; do
        [ -d "$dev" ] || continue
        name="${dev##*/}"
        # 跳过回环和虚拟设备
        case "$name" in
            lo|bridge|docker|virbr) continue ;;
        esac
        echo "$name"
        return 0
    done

    echo "eth0"  # 默认 fallback
    return 1
}

# 启动网络
start_network() {
    echo "[network] Starting network initialization..."

    # 等待设备初始化
    sleep 2

    # 检测网卡
    NETDEV=$(detect_netdev)
    echo "[network] Detected network device: $NETDEV"

    # 确保设备存在
    if [ ! -d "/sys/class/net/$NETDEV" ]; then
        echo "[network] ERROR: Device $NETDEV not found"
        log_jsonl "network_error" "reason=device_not_found" "device=$NETDEV"
        return 1
    fi

    # 启用网卡
    ip link set "$NETDEV" up
    echo "[network] Brought up $NETDEV"

    # 等待网卡稳定
    sleep 1

    # 尝试 DHCP 获取 IP
    if command -v udhcpcd >/dev/null 2>&1; then
        echo "[network] Starting udhcpcd..."
        udhcpcd -d "$NETDEV" 2>&1 || true
    elif command -v udhcpc >/dev/null 2>&1; then
        echo "[network] Starting udhcpc..."
        udhcpc -i "$NETDEV" -q 2>&1 || true
    else
        echo "[network] No DHCP client found, using static IP"
        configure_static_ip "$NETDEV"
    fi

    # 显示结果
    sleep 1
    echo "[network] Current network status:"
    ip addr show "$NETDEV" 2>/dev/null | grep "inet " || echo "[network] No IP address assigned"

    # 记录成功日志
    local ip_addr
    ip_addr=$(ip -4 addr show "$NETDEV" 2>/dev/null | grep -o 'inet [0-9.]*' | awk '{print $2}' || echo "none")
    log_jsonl "network_started" "device=$NETDEV" "ip=$ip_addr"
    echo "[network] Network initialization complete"
}

# 配置静态 IP（备用方案，配合 QEMU user 网络）
configure_static_ip() {
    local dev="$1"
    # QEMU user NAT 默认: 10.0.2.15/24, gateway: 10.0.2.2
    ip addr add 10.0.2.15/24 dev "$dev" 2>/dev/null || true
    ip route add default via 10.0.2.2 2>/dev/null || true

    # 设置 DNS
    mkdir -p /run
    echo "nameserver 8.8.8.8" > /run/resolv.conf
    echo "nameserver 114.114.114.114" >> /run/resolv.conf
}

# 停止网络
stop_network() {
    local NETDEV
    NETDEV=$(detect_netdev)
    ip link set "$NETDEV" down 2>/dev/null || true
    echo "[network] Network stopped"
}

# 主入口
case "$1" in
    start)
        start_network
        ;;
    stop)
        stop_network
        ;;
    restart)
        stop_network
        sleep 1
        start_network
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
