#!/bin/sh
#
# S40network — AgentOS network initialization script
#
# Functions:
#   1. Wait for network device to be ready
#   2. Configure virtio-net network interface
#   3. Start DHCP client to get IP
#   4. Configure DNS and default route
#
# Called by inittab ::sysinit, executed before rcS.local
#

set -e

TRACE_DIR="${TRACE_DIR:-/var/log/sandbox/trace}"
TRACE_JSONL="$TRACE_DIR/trace.jsonl"

log_jsonl() {
    local event="$1"
    shift
    local ts
    ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    mkdir -p "$TRACE_DIR" 2>/dev/null || true
    printf '%s\n' "{\"event\":\"$event\",\"ts\":\"$ts\",\"$*\"}" >> "$TRACE_JSONL" 2>/dev/null || true
}

has_ipv4_address() {
    local dev="$1"
    ip -4 addr show "$dev" 2>/dev/null | grep -q 'inet '
}

has_default_route() {
    ip route 2>/dev/null | grep -q '^default '
}

# Detect network device name
detect_netdev() {
    # virtio-net is usually named eth0, but may be other names in some cases
    # Check common network device names
    for dev in eth0 ens3 enp0s3; do
        if ip link show "$dev" >/dev/null 2>&1; then
            echo "$dev"
            return 0
        fi
    done

    # Dynamic detection: find first available non-lo device via ip link
    if command -v ip >/dev/null 2>&1; then
        ip -o link show 2>/dev/null | while IFS=: read -r idx name rest; do
            name=$(echo "$name" | tr -d ' ')
            case "$name" in
                ""|lo|bridge|docker*|virbr*) continue ;;
            esac
            echo "$name"
            return 0
        done
    fi

    echo "eth0"  # Default fallback
    return 1
}

# Start network
start_network() {
    echo "[network] Starting network initialization..."

    # Wait for device initialization
    sleep 2

    # Detect network device
    NETDEV=$(detect_netdev)
    echo "[network] Detected network device: $NETDEV"

    # Ensure device exists
    if ! ip link show "$NETDEV" >/dev/null 2>&1; then
        echo "[network] ERROR: Device $NETDEV not found"
        log_jsonl "network_error" "reason=device_not_found" "device=$NETDEV"
        return 1
    fi

    # Enable network device
    ip link set "$NETDEV" up
    echo "[network] Brought up $NETDEV"

    # Wait for device to stabilize
    sleep 1

    # Try DHCP to get IP
    if command -v udhcpcd >/dev/null 2>&1; then
        echo "[network] Starting udhcpcd..."
        udhcpcd -d "$NETDEV" 2>&1 || true
    elif command -v udhcpc >/dev/null 2>&1; then
        echo "[network] Starting udhcpc..."
        udhcpc -i "$NETDEV" -q -n -t 5 -T 3 2>&1 || true
    else
        echo "[network] No DHCP client found, using static IP"
        configure_static_ip "$NETDEV"
    fi

    # If DHCP didn't produce usable network state, fallback to QEMU user-net static config
    if ! has_ipv4_address "$NETDEV" || ! has_default_route; then
        echo "[network] DHCP did not produce a usable route, falling back to static QEMU user-net config"
        configure_static_ip "$NETDEV"
    fi

    # Show results
    sleep 1
    echo "[network] Current network status:"
    ip addr show "$NETDEV" 2>/dev/null | grep "inet " || echo "[network] No IP address assigned"
    ip route 2>/dev/null || true

    # Log success
    local ip_addr
    ip_addr=$(ip -4 addr show "$NETDEV" 2>/dev/null | grep -o 'inet [0-9.]*' | awk '{print $2}' || echo "none")
    local route_state
    if has_default_route; then
        route_state="default_route_present"
    else
        route_state="default_route_missing"
    fi
    log_jsonl "network_started" "device=$NETDEV" "ip=$ip_addr" "route=$route_state"
    echo "[network] Network initialization complete"
}

# Configure static IP (backup plan, with QEMU user network)
configure_static_ip() {
    local dev="$1"
    # QEMU user NAT default: 10.0.2.15/24, gateway: 10.0.2.2
    ip link set "$dev" up 2>/dev/null || true
    ip addr add 10.0.2.15/24 dev "$dev" 2>/dev/null || true
    ip route add default via 10.0.2.2 2>/dev/null || true

    # Set DNS
    mkdir -p /run
    echo "nameserver 8.8.8.8" > /run/resolv.conf
    echo "nameserver 114.114.114.114" >> /run/resolv.conf
}

# Stop network
stop_network() {
    local NETDEV
    NETDEV=$(detect_netdev)
    ip link set "$NETDEV" down 2>/dev/null || true
    echo "[network] Network stopped"
}

# Main entry
case "$1" in
    start)
        start_network
        ;;
    stop)
        stop_network
        ;;
    restart)
        stop_network
        sleep 1
        start_network
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
